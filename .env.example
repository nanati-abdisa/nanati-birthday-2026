# Nanati Birthday Celebration Configuration
# Copy this file to ".env" and edit it. (".env" is read automatically on start.)
PORT=3000

# Optional MySQL Database Connection Settings
# (If MySQL is not running or invalid, the app automatically runs on SQLite)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nanati_birthday

# Admin account, created the FIRST time the server starts (password is stored hashed).
# After that, change the password from the dashboard (Overview tab).
ADMIN_DEFAULT_USER=nanati
ADMIN_DEFAULT_PASS=nanati2026

# Hosting behind a proxy (Render, Railway, nginx...)? Uncomment so each guest is
# rate-limited by their real IP, not the proxy's:
# TRUST_PROXY=1
